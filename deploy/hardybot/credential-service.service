[Unit]
Description=Hardy Home protected Connections HTTPS ingress
Wants=network-online.target
After=network-online.target openclaw-gateway.service

[Service]
Type=simple
User=hardy-credentials
Group=@OWNER_GROUP@
SupplementaryGroups=hardy-credentials
RuntimeDirectory=hardy-home-credentials
RuntimeDirectoryMode=0750
WorkingDirectory=/opt/hardy-home-credentials/source/services/household-control
EnvironmentFile=/etc/hardy-home-credentials/service.env
Environment=PATH=/opt/hardy-home-credentials/runtime/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=HOME=/var/lib/hardy-home-credentials
ExecStart=/opt/hardy-home-credentials/runtime/bin/node src/connections/server.ts
Restart=on-failure
RestartSec=3
TimeoutStopSec=75
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/hardy-home-credentials @DATABASE_DIRECTORY@
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock -@OPERATOR_HOME@/.ssh -@OPERATOR_HOME@/.config/hardy-home -@OPERATOR_HOME@/.openclaw
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
