NODE_ENV=production
BIND_ADDRESS=127.0.0.1
PORT=4317
# Replace with the actual protected application state path for this deployment.
HARDY_HOME_DATABASE=/absolute/protected/application-state/household-control.sqlite
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=replace-with-the-existing-gateway-token

# Slice 1: optional paths default under the existing application state/home.
# Set explicit absolute paths in the protected production environment.
# HARDY_HOME_STATE_ROOT=/absolute/protected/application-state
# HARDY_HOME_ARTIFACT_ROOT=/absolute/protected/application-state/artifacts
# OPENCLAW_CONFIG_PATH=/absolute/protected/openclaw.json
# HARDY_HOME_SANDBOX_IMAGE=sha256:the-exact-built-image-id
# HARDY_HOME_PYTHON_PATH=/absolute/python3
# HARDY_HOME_DOCUMENT_READER=/absolute/read-pdf
# BWS_BIN=/absolute/trusted/bws
# BWS_CONFIG_FILE=/absolute/private/automation-only-bws.toml
# BWS_ACCESS_TOKEN and BWS_ALLOWED_SECRET_IDS belong only in protected config.
# The bootstrap is not configured by installing the resolver.
# Use false for inactive candidate startup or to hold delivery during recovery.
HARDY_HOME_DISPATCH_ENABLED=true

# Slice 2: generated protected domain/resource configuration (required in production mode).
HARDY_HOME_DOMAINS_CONFIG=/absolute/private/domains.json

# Optional local Android dictation. Both paths are required for transcription.
# HARDY_HOME_DICTATION_PYTHON=/absolute/path/to/pinned/venv/bin/python
# HARDY_HOME_DICTATION_MODEL=/absolute/path/to/pinned/whisper-model
